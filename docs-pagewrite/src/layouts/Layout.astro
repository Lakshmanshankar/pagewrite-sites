---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/docs/Header.astro';
import Sidebar from '../components/docs/Sidebar.astro';
import Footer from '../components/layout/Footer.astro';
import Pagination from '../components/ui/Pagination.astro';
import PagewriteScript from './Scripts.astro'
import '../styles/global.css';

import { TableOfContent, Header as MetaHeader } from 'pagewrite-ui/docs';
import { ContextMenu } from 'pagewrite-ui/components';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface PageLink {
  title: string;
  url: string;
  description?: string;
}

interface Props {
  title: string;
  description?: string;
  metaTitle?: string;
  metaDescription?: string;
  metaKeywords?: string[];
  noindex?: boolean;
  isDocsPage?: boolean;
  activeSlug?: string;
  headings?: Heading[];
  activeTab?: 'docs' | 'showcase' | 'api' | 'home';
  prev?: PageLink;
  next?: PageLink;
  lastModified?: string;
}

const {
  title,
  description = "Pagewrite visual documentation CMS theme for Astro",
  metaTitle,
  metaDescription,
  metaKeywords,
  noindex,
  isDocsPage = false,
  activeSlug,
  headings = [],
  activeTab = 'home',
  prev,
  next,
  lastModified
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full dark bg-background text-text">
  <head>
    <MetaHeader 
      title={metaTitle ? `${metaTitle} | Pagewrite Docs` : `${title} | Pagewrite Docs`}
      description={metaDescription || description}
      keywords={metaKeywords}
      noindex={noindex}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Load Google Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <PagewriteScript />
    {/* Theme Initializer Script */}
    <script is:inline>
      const applyTheme = () => {
        if (
          localStorage.theme === 'light' ||
          (!('theme' in localStorage) && !window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('light');
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.remove('light');
          document.documentElement.classList.add('dark');
        }
      };
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
    <ClientRouter />
  </head>
  <body class="h-full bg-background text-text antialiased selection:bg-brand-color/20">
    <div class="min-h-full flex flex-col">
      {/* Header navbar */}
      <Header activeTab={activeTab} />
      
      {isDocsPage ? (
        <div class="max-w-[1600px] w-full mx-auto px-4 sm:px-6 lg:px-8 flex-1 flex flex-col md:flex-row pt-14 md:pt-0 md:gap-8">
          {/* Left Sidebar */}
          <Sidebar activeSlug={activeSlug} />
          
          {/* Center Content Column + Right TOC */}
          <div class="flex-1 w-full flex flex-col">
            <div class="flex-1 flex flex-col w-full pl-2 sm:px-6 lg:px-8">
              <div class="flex-1 w-full max-w-6xl py-8 flex flex-col lg:flex-row mx-auto gap-10 xl:gap-16 justify-between">
                <main class="flex-1 w-full min-w-0 flex flex-col justify-between">
                  <div class="w-full max-w-3xl">
                    <div class="mb-8 pb-6 border-b border-border-line/60 flex items-start justify-between gap-4">
                      <div class="w-[80%]">
                        <h1 class="text-3xl sm:text-4xl font-semibold font-heading text-text-title tracking-tight mb-3 capitalize">
                          {title === 'index' ? 'Overview' : title.replace(/-/g, ' ')}
                        </h1>
                        {description && description !== "Pagewrite visual documentation CMS theme for Astro" && (
                          <p class="text-lg text-text-muted mb-6 leading-relaxed">
                            {description}
                          </p>
                        )}
                      </div>
                      <div class="w-[20%] flex justify-end">
                        <ContextMenu />
                      </div>
                    </div>

                    <article class="prose w-full animate-fade-in mt-2 max-w-[720px]">
                      <slot />
                    </article>
                    
                    {isDocsPage && lastModified && (
                      <div class="mt-10 mb-2 text-sm text-text-muted flex justify-end items-center">
                        Last updated on&nbsp;<span class="last-modified-time font-medium" data-time={lastModified}>{new Date(lastModified).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                      </div>
                    )}
                    
                    {isDocsPage && (prev || next) && (
                      <Pagination prev={prev} next={next} />
                    )}
                  </div>
                  <Footer />
                </main>
                
                <TableOfContent headings={headings} />
              </div>
            </div>
          </div>
        </div>
      ) : (
        <div class="flex-1 flex flex-col pt-14">
          <main class="flex-1">
            <slot />
          </main>
          <div class="max-w-3xl mx-auto w-full px-4 sm:px-6 lg:px-8">
            <Footer />
          </div>
        </div>
      )}
    </div>

    <script>
      document.addEventListener('astro:page-load', () => {
        // Add wrappers to markdown tables for responsive horizontal scrolling
        const tables = document.querySelectorAll('.prose table');
        tables.forEach((table) => {
          if (table.parentElement?.classList.contains('table-wrapper')) return;
          const wrapper = document.createElement('div');
          wrapper.className = 'table-wrapper overflow-x-auto max-w-full my-6';
          // Move the my-6 margin from the table to the wrapper, if needed.
          // Since table already has my-6 from tailwind apply, it might double up,
          // but we can just let tailwind handle it or remove margin from table via JS.
          table.style.marginTop = '0';
          table.style.marginBottom = '0';
          if (table.parentNode) {
            table.parentNode.insertBefore(wrapper, table);
            wrapper.appendChild(table);
          }
        });


        // Format last modified times to local timezone
        const timeElements = document.querySelectorAll('.last-modified-time');
        timeElements.forEach((el) => {
          const isoTime = el.getAttribute('data-time');
          if (isoTime) {
            const date = new Date(isoTime);
            el.textContent = new Intl.DateTimeFormat(undefined, {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
              hour: 'numeric',
              minute: '2-digit',
              timeZoneName: 'short'
            }).format(date);
          }
        });
      });
    </script>
  </body>
</html>
