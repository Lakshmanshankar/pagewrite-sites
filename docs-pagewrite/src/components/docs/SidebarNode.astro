---
interface PageNode {
  id: string;
  title: string;
  slug: string;
  children?: PageNode[];
}

interface Props {
  nodes: PageNode[];
  activeSlug?: string;
  docMap: Map<string, any>;
  depth?: number;
}

const { nodes, activeSlug, docMap, depth = 0 } = Astro.props;

function capitalize(str: string): string {
  if (!str) return str;
  return str.charAt(0).toUpperCase() + str.slice(1);
}

function isNodeActive(node: PageNode, currentSlug?: string): boolean {
  if (!currentSlug || !node.slug) return false;
  if (node.slug === currentSlug) return true;
  const normalize = (s: string) => s.replace(/\/index$/, '').replace(/^index$/, '');
  return normalize(node.slug) === normalize(currentSlug);
}

function hasActiveDescendant(node: PageNode, currentSlug?: string): boolean {
  if (!node.children || !currentSlug) return false;
  return node.children.some((child) => {
    if (isNodeActive(child, currentSlug)) return true;
    return hasActiveDescendant(child, currentSlug);
  });
}
---

{nodes.map((node) => {
  const hasChildren = node.children && node.children.length > 0;
  
  if (hasChildren) {
    const isOpen = hasActiveDescendant(node, activeSlug);
    const folderTitle = capitalize(node.title);
    
    return (
      <li class="list-none folder-node">
        <button type="button" class="folder-toggle w-full flex items-center justify-between px-2 py-1 text-sm rounded-md transition-colors duration-300 hover:bg-secondary cursor-pointer text-left">
          <span>{folderTitle}</span>
          <svg 
            xmlns="http://www.w3.org/2000/svg" 
            viewBox="0 0 24 24" 
            fill="none" 
            stroke="currentColor" 
            stroke-width="2" 
            stroke-linecap="round" 
            stroke-linejoin="round" 
            class={`text-text-muted transition-transform duration-300 folder-icon ${isOpen ? 'rotate-90' : ''}`}
            style="width: 14px; height: 14px; min-width: 14px; flex-shrink: 0;"
          >
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </button>
        <div class={`folder-content grid transition-[grid-template-rows] duration-300 ease-in-out ${isOpen ? 'grid-rows-[1fr]' : 'grid-rows-[0fr]'}`}>
          <div class="overflow-hidden">
            <ul class="pl-2 border-l border-border-line/45 ml-3 mt-0.5 space-y-0.5">
              <Astro.self 
                nodes={node.children!} 
                activeSlug={activeSlug} 
                docMap={docMap} 
                depth={depth + 1} 
              />
            </ul>
          </div>
        </div>
      </li>
    );
  } else {
    const doc = docMap.get(node.id);
    const isSelf = isNodeActive(node, activeSlug);
    const title = node.title === 'index' ? 'Overview' : (doc?.data?.title || node.title);
    const href = node.slug === 'index' ? '/' : `/${node.slug.endsWith('/index') ? node.slug.slice(0, -6) : node.slug}`;
    
    return (
      <li class="list-none">
        <a
          href={href}
          class={`flex items-center px-2 py-1 text-sm rounded-md border transition-all duration-300 ${
            isSelf
              ? "bg-brand-color/5 text-brand-color border-none"
              : "border-transparent hover:bg-secondary"
          }`}
        >
          {title}
        </a>
      </li>
    );
  }
})}

<script>
  // Event delegation to handle folder toggles (survives view transitions)
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const toggleBtn = target.closest('.folder-toggle');
    if (toggleBtn) {
      const node = toggleBtn.closest('.folder-node');
      if (!node) return;
      
      const content = node.querySelector(':scope > .folder-content');
      const icon = toggleBtn.querySelector('.folder-icon');
      
      if (content && icon) {
        const isClosed = content.classList.contains('grid-rows-[0fr]');
        if (isClosed) {
          content.classList.remove('grid-rows-[0fr]');
          content.classList.add('grid-rows-[1fr]');
          icon.classList.add('rotate-90');
        } else {
          content.classList.remove('grid-rows-[1fr]');
          content.classList.add('grid-rows-[0fr]');
          icon.classList.remove('rotate-90');
        }
      }
    }
  });
</script>
